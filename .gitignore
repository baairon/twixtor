# parity: original plugins, Microsoft runtime files, Adobe SDK derived layouts, plugin address dumps, throwaway diagnostics and regenerable heavy data stay out of the repository
*.aex
parity/**/rootfs/
parity/harness/results/*capture*
parity/harness/e1.py
parity/harness/e1b.py
